<header class="site-header">
  <div class="site-shell site-header__inner">
    <a class="site-brand" href="{{ path('<front>') }}">ORBITL</a>
    {% if page.primary_menu %}
      <nav class="site-menu" aria-label="Primary navigation">
        {{ page.primary_menu }}
      </nav>
    {% endif %}
  </div>
</header>

<main class="site-main">
  {% if is_front %}
    <section class="hero">
      <div class="site-shell">
        <h1>ORBITL</h1>
        <p>Student-led space technology, satellite systems, and research at KMITL.</p>
      </div>
    </section>
  {% endif %}

  <div class="site-shell content-band">
    {{ page.content }}
  </div>
</main>

<footer class="site-footer">
  <div class="site-shell">
    <p>&copy; {{ "now"|date("Y") }} ORBITL</p>
  </div>
</footer>

