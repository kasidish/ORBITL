# Example environment variables for the web app

# Strapi (headless CMS for news)
# Set to your Strapi instance URL (e.g. https://your-strapi.example or http://localhost:1337)
VITE_STRAPI_URL=

# PocketBase (optional)
VITE_POCKETBASE_URL=

# Optional: the collection name used for contact form messages
VITE_POCKETBASE_CONTACT_COLLECTION=contact_messages

# Supabase (optional)
# If you use Supabase, create a project and set these values (dashboard → Project settings → API)
VITE_SUPABASE_URL=https://lfckizixajytdsnpshqx.supabase.co
# NOTE: Do NOT commit real keys. Replace the value below with your anon key in your local `.env.local`.
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE
